# Copy to .env (never commit it) and fill in. Generate secrets with: openssl rand -base64 48

# Domain of the app; schools live at <school>.ROOT_DOMAIN
ROOT_DOMAIN=educare.arthurlamberti.com
# Port on 127.0.0.1 where nginx reaches the web
WEB_PORT=3100

POSTGRES_PASSWORD=
# At least 32 bytes
EDUCARE_JWT_SECRET=
# Key for /api/platform/** scripts
EDUCARE_PLATFORM_KEY=
# System admin (operator panel at https://ROOT_DOMAIN/admin); set the password with "Esqueci a senha"
EDUCARE_ADMIN_EMAIL=

# Outgoing email (sign-up confirmation, password reset, notices): any SMTP provider
EDUCARE_MAIL_FROM=Educare <nao-responda@arthurlamberti.com>
# Told when a new private space waits for activation (optional)
EDUCARE_MAIL_OPERATOR=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Virtual rooms of online lessons (LiveKit Cloud project); empty: joining them answers 503
EDUCARE_LIVEKIT_URL=
EDUCARE_LIVEKIT_API_KEY=
EDUCARE_LIVEKIT_API_SECRET=
