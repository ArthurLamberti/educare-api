# VPS: copy to .env next to docker-compose.yml (never commit it). Generate secrets with: openssl rand -base64 48

# Database
DATABASE_NAME=educare
DATABASE_USERNAME=educare
DATABASE_PASSWORD=
DATABASE_PORT=5434

# Application
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=prod
# At least 32 bytes
EDUCARE_JWT_SECRET=
EDUCARE_PLATFORM_KEY=
# System admin (operator panel at https://<ROOT_DOMAIN>/admin); set the password with "Esqueci a senha"
EDUCARE_ADMIN_EMAIL=

# Schools live at <school>.<ROOT_DOMAIN>
ROOT_DOMAIN=educare.arthurlamberti.com
WEB_SCHEME=https

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM="Educare <nao-responda@arthurlamberti.com>"
# Told when a new private space waits for activation (optional)
MAIL_OPERATOR=

# Virtual rooms of online lessons (LiveKit Cloud project)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
